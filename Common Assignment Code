"""Multi-client server where TCP and UDP listen on the same port number."""

import argparse
import random
import socket
import socketserver
import threading
import time

LOG = []
LOG_LOCK = threading.Lock()


def log_event(**fields):
    """Record a timestamped server event in a thread-safe log."""
    fields["time"] = time.time()
    with LOG_LOCK:
        LOG.append(fields)
    print(f"[{fields['proto']}] {fields}")


class TCPHandler(socketserver.StreamRequestHandler):
    """Handle incoming TCP client connections and acknowledge each line."""

    def handle(self):
        peer = self.client_address
        log_event(proto="TCP", event="connected", peer=peer)
        try:
            for raw in self.rfile:
                line = raw.decode().rstrip("\n")
                if not line:
                    continue
                client_id, seq, payload = line.split("|", 2)
                log_event(
                    proto="TCP",
                    event="received",
                    client=client_id,
                    seq=int(seq),
                    size=len(payload),
                    peer=peer,
                )
                self.wfile.write(f"ACK|{client_id}|{seq}\n".encode())
                self.wfile.flush()
        finally:
            log_event(proto="TCP", event="closed", peer=peer)


class ThreadedTCPServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    allow_reuse_address = True
    daemon_threads = True


class UDPServer(threading.Thread):
    """Receives datagrams and acknowledges each one.

    drop_rate injects loss at the application layer so the sender experiences
    a lost message as it would on a congested network.
    """

    def __init__(self, host: str, port: int, drop_rate: float = 0.0):
        super().__init__(daemon=True)
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.sock.bind((host, port))
        self.sock.settimeout(0.1)
        self.drop_rate = drop_rate
        self.running = True

    def run(self):
        while self.running:
            try:
                data, peer = self.sock.recvfrom(65535)
            except socket.timeout:
                continue
            except OSError:
                break

            client_id, seq, payload = data.decode().split("|", 2)
            if random.random() < self.drop_rate:
                log_event(
                    proto="UDP",
                    event="dropped",
                    client=client_id,
                    seq=int(seq),
                    peer=peer,
                )
                continue

            log_event(
                proto="UDP",
                event="received",
                client=client_id,
                seq=int(seq),
                size=len(payload),
                peer=peer,
            )
            self.sock.sendto(f"ACK|{client_id}|{seq}".encode(), peer)

    def stop(self):
        self.running = False
        self.join(timeout=1)
        self.sock.close()


def start_server(host: str = "127.0.0.1", port: int = 9100, udp_drop_rate: float = 0.0):
    tcp = ThreadedTCPServer((host, port), TCPHandler)
    threading.Thread(target=tcp.serve_forever, daemon=True).start()
    udp = UDPServer(host, port, drop_rate=udp_drop_rate)
    udp.start()
    return tcp, udp


def stop_server(servers):
    tcp, udp = servers
    tcp.shutdown()
    tcp.server_close()
    udp.stop()


def main():
    parser = argparse.ArgumentParser(description="Start dual TCP/UDP server")
    parser.add_argument("--host", default="127.0.0.1", help="Host interface to bind")
    parser.add_argument("--port", type=int, default=9100, help="Port number for TCP and UDP")
    parser.add_argument(
        "--drop-rate",
        type=float,
        default=0.0,
        help="Simulated UDP packet drop rate (0.0 to 1.0)",
    )
    args = parser.parse_args()

    servers = start_server(args.host, args.port, args.drop_rate)
    print(f"Server listening on {args.host}:{args.port} (TCP & UDP). Press Ctrl+C to stop.")
    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("\nShutting down server...")
        stop_server(servers)


if __name__ == "__main__":
    main()
