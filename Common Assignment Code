"""Client for the dual TCP and UDP server. Sends messages and measures RTT."""

import argparse
import socket
import time


def tcp_session(host: str, port: int, client_id: str, messages: list[str]) -> dict:
    t0 = time.perf_counter()
    sock = socket.create_connection((host, port))
    connect_time = time.perf_counter() - t0
    stream = sock.makefile("rwb")

    results = []
    for seq, payload in enumerate(messages, 1):
        t = time.perf_counter()
        sock.sendall(f"{client_id}|{seq}|{payload}\n".encode())
        reply = stream.readline().decode().strip()
        rtt = time.perf_counter() - t
        results.append(
            {
                "seq": seq,
                "rtt": rtt,
                "acked": reply == f"ACK|{client_id}|{seq}",
            }
        )

    sock.close()
    return {"connect": connect_time, "results": results}


def udp_session(
    host: str,
    port: int,
    client_id: str,
    messages: list[str],
    timeout: float = 0.05,
    retries: int = 0,
) -> dict:
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.settimeout(timeout)

    results = []
    for seq, payload in enumerate(messages, 1):
        datagram = f"{client_id}|{seq}|{payload}".encode()
        expected = f"ACK|{client_id}|{seq}"
        acked, attempts = False, 0
        t = time.perf_counter()

        for _ in range(retries + 1):
            attempts += 1
            sock.sendto(datagram, (host, port))
            try:
                while True:
                    reply, _ = sock.recvfrom(2048)
                    if reply.decode() == expected:
                        acked = True
                        break
            except socket.timeout:
                pass
            if acked:
                break

        rtt = time.perf_counter() - t
        results.append(
            {
                "seq": seq,
                "rtt": rtt,
                "acked": acked,
                "attempts": attempts,
            }
        )

    sock.close()
    return {"connect": 0.0, "results": results}


def main():
    parser = argparse.ArgumentParser(description="Send messages over TCP or UDP")
    parser.add_argument("--host", default="127.0.0.1", help="Server host")
    parser.add_argument("--port", type=int, default=9100, help="Server port")
    parser.add_argument("--proto", choices=["tcp", "udp"], default="tcp", help="Protocol")
    parser.add_argument("--id", default="C1", help="Client identifier")
    parser.add_argument(
        "--message",
        action="append",
        required=True,
        help="Message payload (can be specified multiple times)",
    )
    parser.add_argument("--timeout", type=float, default=0.05, help="UDP timeout in seconds")
    parser.add_argument("--retries", type=int, default=0, help="UDP retry count")
    args = parser.parse_args()

    if args.proto == "tcp":
        out = tcp_session(args.host, args.port, args.id, args.message)
    else:
        out = udp_session(
            args.host, args.port, args.id, args.message, args.timeout, args.retries
        )

    print(f"connection setup {out['connect'] * 1000:.3f} ms")
    for r in out["results"]:
        status = "ACK received" if r["acked"] else "no acknowledgment"
        print(f"message {r['seq']}: {status}, time {r['rtt'] * 1000:.3f} ms")


if __name__ == "__main__":
    main()
